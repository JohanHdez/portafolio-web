---
import {
  profile, ui, agents, cases, smallProjects, clientWork, experience, education, stack, type Lang,
} from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const home = lang === 'es' ? '/' : '/en/';
const otherHref = lang === 'es' ? '/en/' : '/';
const linkText = { visit: `${t.work.visit} ↗`, code: `${t.work.code} ↗`, store: `${t.work.store} ↗`, app: `${t.work.app} ↗`, play: `▶ ${t.more.play}`, apk: `${t.more.apk} ↓` };
const mail = (subject: string, body = '') =>
  `mailto:${profile.email}?subject=${encodeURIComponent(subject)}${body ? `&body=${encodeURIComponent(body)}` : ''}`;
// Correo ya escrito para pedir acceso a un repo privado: proyecto, enlace y los datos que necesito.
const access = (name: string, repo: string) => {
  const r = t.request;
  const subject = `${t.more.requestSubject} ${name}`;
  const body = [r.greeting, '', `${r.want} ${name}.`, `${r.repo}: ${repo}`, '', r.fill, ...r.fields, '', r.thanks].join('\n');
  return { href: mail(subject, body), subject, body };
};
---
<header class="nav">
  <div class="wrap nav-in">
    <a href={home} class="mark" aria-label={profile.name}>Johan Hernández<span>.</span></a>
    <nav aria-label="Main">
      <a href="#work">{t.nav.work}</a>
      <a href="#how">{t.nav.how}</a>
      <a href="#experience">{t.nav.experience}</a>
      <a href="#contact">{t.nav.contact}</a>
      <a href={otherHref} class="pill" hreflang={lang === 'es' ? 'en' : 'es'}>{t.langSwitch}</a>
    </nav>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-text">
      <p class="meta mono">
        <span class="dot" aria-hidden="true"></span>
        {profile.location} · <time id="clock" data-suffix={t.localTime}>—</time> · {t.hero.status}
      </p>
      <p class="hello">{t.hero.hello} <strong>{profile.name}</strong>.</p>
      <h1>
        <span>{t.hero.line1}</span>
        <span>{t.hero.line2}</span>
        <span><em class="mark-hl">{t.hero.line3}</em></span>
      </h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="actions">
        <a class="btn ink" href="#work">{t.hero.ctaWork} ↓</a>
        <a class="btn" href={profile.cv} download>{t.hero.ctaCv}</a>
      </div>
    </div>

    <aside class="now" aria-label={t.hero.nowLabel}>
      <p class="now-label mono">● {t.hero.nowLabel}</p>
      <h2>{t.hero.nowTitle}</h2>
      <p>{t.hero.nowText}</p>
      <a href={profile.kmaleon} target="_blank" rel="noopener" class="now-link">{t.hero.nowLink} ↗</a>
      <img src="/projects/kmaleon-mobile.webp" alt="" width="390" height="844" class="now-phone" />
    </aside>
  </section>

  <section class="numbers wrap" aria-label="Datos">
    {t.numbers.map((n) => (
      <div>
        <strong>{n.value}</strong>
        <span>{n.label}</span>
      </div>
    ))}
  </section>

  <!-- CASOS -->
  <section id="work" class="wrap section">
    <p class="kicker mono">{t.work.kicker}</p>
    <h2 class="section-title">{t.work.title}</h2>

    {cases.map((c, i) => (
      <article class={`case${i % 2 ? ' flip' : ''}`} style={`--accent:${c.accent}`} id={c.slug}>
        <div class="case-media-col">
        <div class="case-media">
          {c.shots.map((s) =>
            s.kind === 'phone' ? (
              <figure class="phone"><img src={s.src} alt={s.alt[lang]} loading="lazy" width="390" height="844" /></figure>
            ) : s.kind === 'panel' ? (
              <figure class="panel"><img src={s.src} alt={s.alt[lang]} loading="lazy" width="420" height="860" /></figure>
            ) : (
              <figure class="browser">
                <div class="bar"><i></i><i></i><i></i><span class="mono">{s.url}</span></div>
                <img src={s.src} alt={s.alt[lang]} loading="lazy" width="1440" height="900" />
              </figure>
            )
          )}
        </div>
        {c.gallery && (
          <div class="gallery">
            <p class="label mono">{t.work.gallery}</p>
            <ul>
              {c.gallery.map((g) => (
                <li class={g.kind === 'phone' ? 'g-phone' : 'g-wide'}>
                  <a href={g.src} target="_blank" rel="noopener" title={g.alt[lang]}>
                    <img src={g.src} alt={g.alt[lang]} loading="lazy" width={g.kind === 'phone' ? 390 : 1280} height={g.kind === 'phone' ? 844 : 800} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        </div>

        <div class="case-body">
          <p class="case-head mono">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span>{c.name}</span>
            <span class="year">{c.year}</span>
          </p>
          {c.badge && <p class="badge mono">{c.badge[lang]}</p>}
          <h3>{c.title[lang]}</h3>
          <p class="summary">{c.summary[lang]}</p>

          <p class="label mono">{t.work.role}: <span>{c.role[lang]}</span></p>
          <ul class="built">{c.built[lang].map((b) => <li>{b}</li>)}</ul>

          {c.metrics.length > 0 && (
            <dl class="metrics">
              {c.metrics.map((m) => (
                <div><dt>{m.value}</dt><dd>{m.label[lang]}</dd></div>
              ))}
            </dl>
          )}

          <ul class="chips mono">{c.stack.map((s) => <li>{s}</li>)}</ul>

          <div class="links">
            {c.links.map((l) => (
              <a class={`btn sm${l.label !== 'code' ? ' accent' : ''}`} href={l.href} target="_blank" rel="noopener">{linkText[l.label]}</a>
            ))}
            {c.requestAccess?.map((r) => {
              const a = access(r.name, r.repo);
              return <a class="btn sm" href={a.href} data-contact data-subject={a.subject} data-body={a.body}>🔒 {t.more.requestCode} · {r.name}</a>;
            })}
            {c.privateCode && <span class="note mono">🔒 {t.work.privateCode}</span>}
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- TAMBIÉN CONSTRUÍ -->
  <section class="wrap section">
    <h2 class="section-title small">{t.more.title}</h2>
    <div class="small-grid">
      {smallProjects.map((p) => (
        <article class="small">
          <a href={p.image} target="_blank" rel="noopener" class="small-img">
            <img src={p.image} alt={p.imageAlt[lang]} loading="lazy" width="1280" height="720" />
          </a>
          <h3>{p.name}</h3>
          <p>{p.text[lang]}</p>
          <ul class="chips mono">{p.tags.map((tag) => <li>{tag}</li>)}</ul>
          <div class="links">
            {p.play && <a class="btn sm accent" href={p.play} target="_blank" rel="noopener">▶ {t.more.play}</a>}
            {p.site && <a class="btn sm accent" href={p.site} target="_blank" rel="noopener">{t.more.visit} ↗</a>}
            {p.apk && <a class={`btn sm${p.play ? '' : ' accent'}`} href={p.apk} target="_blank" rel="noopener">{t.more.apk} ↓</a>}
            {p.privateRepo && (() => {
              const a = access(p.name, p.privateRepo);
              return <a class="btn sm" href={a.href} data-contact data-subject={a.subject} data-body={a.body}>🔒 {t.more.requestCode}</a>;
            })()}
            {p.repo && <a class="btn sm" href={p.repo} target="_blank" rel="noopener">{t.more.code} ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CÓMO TRABAJO -->
  <section id="how" class="how">
    <div class="wrap">
      <p class="kicker mono">{t.how.kicker}</p>
      <h2 class="section-title">{t.how.title}</h2>
      <p class="section-lead">{t.how.text}</p>

      <div class="team" aria-hidden="true">
        <div class="human">
          <span class="avatar">JH</span>
          <div><strong>{t.how.me}</strong><small>{t.how.meRole}</small></div>
        </div>
        <div class="wire"></div>
        <ul class="agents">
          {agents.map((a, i) => <li class="mono"><span>{String(i + 1).padStart(2, '0')}</span>{a[lang]}</li>)}
        </ul>
      </div>

      <ol class="steps">
        {t.how.steps.map((s) => (
          <li>
            <span class="mono">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
      <p class="footnote">{t.how.footnote}</p>
    </div>
  </section>

  <!-- CLIENTES -->
  <section class="wrap section">
    <p class="kicker mono">{t.clients.kicker}</p>
    <h2 class="section-title">{t.clients.title}</h2>
    <div class="clients">
      {clientWork.map((c) => (
        <article>
          <p class="mono client-name">{c.name}</p>
          <h3>{c.title[lang]}</h3>
          <p>{c.text[lang]}</p>
          <p class="result">{c.result[lang]}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- TRAYECTORIA -->
  <section id="experience" class="wrap section">
    <p class="kicker mono">{t.experience.kicker}</p>
    <h2 class="section-title">{t.experience.title}</h2>
    <ol class="timeline">
      {experience.map((e) => (
        <li>
          <span class="when mono">{e.period[lang]}</span>
          <div>
            <h3>{e.role[lang]} <span class="org">— {e.org[lang]}</span></h3>
            <p>{e.text[lang]}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="bottom-grid">
      <div>
        <h3 class="mono sub">{t.experience.education}</h3>
        <ul class="plain">{education.map((e) => <li>{e[lang]}</li>)}</ul>
      </div>
      <div class="stack">
        {stack.map((g) => (
          <div>
            <h3 class="mono sub">{g.group[lang]}</h3>
            <ul class="chips mono">{g.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section id="contact" class="contact">
    <div class="wrap">
      <p class="kicker mono">{t.contact.kicker}</p>
      <h2>{t.contact.title}</h2>
      <p class="lead">{t.contact.text}</p>
      <a class="big-mail" href={`mailto:${profile.email}`} data-contact data-subject={t.contact.subject}>{profile.email}</a>
      <div class="actions">
        <a class="btn light" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a class="btn light" href={profile.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a class="btn light" href={profile.cv} download>{t.hero.ctaCv} ↓</a>
      </div>
    </div>
  </section>
</main>

<dialog id="contact-dialog" class="contact-dialog" data-email={profile.email}>
  <form method="dialog">
    <p class="kicker mono">{t.dialog.kicker}</p>
    <h2 id="cd-subject">{t.contact.subject}</h2>
    <p class="cd-text">{t.dialog.text}</p>
    <div class="cd-actions">
      <a class="btn ink" id="cd-gmail" target="_blank" rel="noopener">{t.dialog.gmail} ↗</a>
      <a class="btn" id="cd-mailto">{t.dialog.app}</a>
      <button type="button" class="btn" id="cd-copy" data-done={t.dialog.copied}>{t.dialog.copy}</button>
    </div>
    <p class="cd-mail mono">{profile.email}</p>
    <button class="cd-close" aria-label={t.dialog.close}>×</button>
  </form>
</dialog>

<footer class="wrap footer mono">
  <span>© {new Date().getFullYear()} {profile.name}</span>
  <span>{t.footer}</span>
</footer>

<script>
  const el = document.getElementById('clock');
  if (el) {
    const lang = document.documentElement.lang === 'en' ? 'en-US' : 'es-CO';
    const fmt = new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit', timeZone: 'America/Bogota' });
    const tick = () => { el.textContent = `${fmt.format(new Date())} ${el.dataset.suffix ?? ''}`; };
    tick();
    setInterval(tick, 30000);
  }

  // Los enlaces mailto no hacen nada si el visitante no tiene una app de correo configurada
  // (lo normal en Windows con Gmail web). Abrimos un diálogo con alternativas que siempre funcionan.
  const dlg = document.getElementById('contact-dialog') as HTMLDialogElement | null;
  if (dlg && typeof dlg.showModal === 'function') {
    const email = dlg.dataset.email ?? '';
    const gmail = dlg.querySelector<HTMLAnchorElement>('#cd-gmail')!;
    const app = dlg.querySelector<HTMLAnchorElement>('#cd-mailto')!;
    const copy = dlg.querySelector<HTMLButtonElement>('#cd-copy')!;
    const title = dlg.querySelector<HTMLElement>('#cd-subject')!;
    const copyLabel = copy.textContent ?? '';

    document.querySelectorAll<HTMLAnchorElement>('[data-contact]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const subject = a.dataset.subject ?? '';
        const body = a.dataset.body ?? '';
        const b = body ? `&body=${encodeURIComponent(body)}` : '';
        title.textContent = subject;
        gmail.href = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent(subject)}${b}`;
        app.href = `mailto:${email}?subject=${encodeURIComponent(subject)}${b}`;
        copy.textContent = copyLabel;
        dlg.showModal();
      });
    });

    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        copy.textContent = copy.dataset.done ?? copyLabel;
      } catch {
        window.prompt('', email);
      }
    });

    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
