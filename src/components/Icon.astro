---
// Iconos de Lucide (ISC), un solo trazo y un solo tamaño en todo el sitio.
export type IconName = 'external' | 'down' | 'download' | 'lock' | 'play';
interface Props { name: IconName }
const { name } = Astro.props;
---
<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'external' && (<><path d="M7 7h10v10" /><path d="M7 17 17 7" /></>)}
  {name === 'down' && (<><path d="M12 5v14" /><path d="m19 12-7 7-7-7" /></>)}
  {name === 'download' && (<><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" /><path d="M12 15V3" /></>)}
  {name === 'lock' && (<><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></>)}
  {name === 'play' && <path d="M6 3 20 12 6 21Z" />}
</svg>
